# Copy this file to .env and adjust as needed for your environment.
# These aren't secrets — just per-environment overrides. The app falls back
# to the syncaxis.com URLs in src/data/apps.js if a variable is unset.
VITE_WEBMAIL_URL=https://webmail.syncaxis.com/
VITE_ERP_URL=http://erp.syncaxis.com/login
VITE_GREYTHR_URL=https://syncaxis.greythr.com/
VITE_INQUIRY_URL=https://inquiry.syncaxis.com/
