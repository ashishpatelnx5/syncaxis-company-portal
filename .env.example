# Copy this file to .env and adjust as needed for your environment.
# These aren't secrets — just per-environment overrides. The app falls back
# to the syncaxis.com URLs in src/data/apps.js if a variable is unset, and to
# port 5173 (Vite's default) if VITE_PORT is unset.
VITE_PORT=5173
# Login gate credentials — this is a client-side-only check (no backend), so
# it deters casual browsing but is NOT real security: the password ends up
# in the built JS bundle in plain text. Set real values in your own .env.
VITE_AUTH_USERNAME=changeme
VITE_AUTH_PASSWORD=changeme
VITE_WEBMAIL_URL=https://webmail.syncaxis.com/
VITE_ERP_URL=http://erp.syncaxis.com/login
VITE_GREYTHR_URL=https://syncaxis.greythr.com/
VITE_INQUIRY_URL=https://inquiry.syncaxis.com/
