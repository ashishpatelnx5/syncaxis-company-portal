# Copy to .env and fill in real values. Never commit .env.
PORT=8050

# SQL Server connection. For a named instance use `HOST\INSTANCE` here (the
# backend splits it automatically) — this requires the SQL Server Browser
# service to be running on that machine so the instance name can resolve.
DB_SERVER=SYNCAXIS-SERVER\SQLEXPRESS
DB_NAME=SYNCAXIS_PORTAL
DB_USER=syncaxis_portal_app
DB_PASSWORD=changeme
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Long random string used to sign login tokens — generate your own, don't
# reuse this or any other example value.
JWT_SECRET=changeme-generate-a-long-random-string
JWT_EXPIRES_IN=8h

# Origin the frontend is served from, for CORS. Comma-separate multiple.
CORS_ORIGIN=http://localhost:5173

# Used only by `npm run seed` to create the first admin login (see
# scripts/seed.js) — not read at server runtime.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme
